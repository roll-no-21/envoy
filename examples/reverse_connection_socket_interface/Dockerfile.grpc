FROM python:3.9-slim

# Install grpcio and grpcio-tools
RUN pip install grpcio grpcio-tools grpcio-reflection

# Create app directory
WORKDIR /app

# Copy the gRPC server
COPY grpc_server.py .
COPY greeter.proto .

# Generate gRPC code
RUN python -m grpc_tools.protoc -I. --python_out=. --grpc_python_out=. greeter.proto

# Expose port
EXPOSE 50051

# Run the server
CMD ["python", "grpc_server.py"] 